@model VoucherHub.ViewModels.LoginVm
@{ ViewData["Title"] = "Admin login"; }
<div class="wrap" style="max-width:420px">
  <h2>Admin login</h2>
  <form method="post" class="card">
    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]">
    <div asp-validation-summary="ModelOnly" class="alert"></div>
    <div class="f">
        <label asp-for="Username">

        </label>
        <input asp-for="Username" autocomplete="username">
    </div>
    <div class="f">
        <label asp-for="Password">

        </label>
        <input asp-for="Password" autocomplete="current-password">
        </div>
    <button class="btn full">Sign in</button>
  </form>
</div>
