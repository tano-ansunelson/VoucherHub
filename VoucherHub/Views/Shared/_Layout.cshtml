<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] – VoucherHub GH</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
    <header class="site">
        <div class="wrap">
            <a class="logo" asp-controller="Home" asp-action="Index">Voucher<b>Hub</b> GH</a>
            <a class="btn sm" asp-controller="Purchase" asp-action="Create">Buy Voucher</a>
        </div>
    </header>
    <main>@RenderBody()</main>
    <footer class="foot">This site only sells result-checker vouchers. It does not check results.</footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
